		},
		{
			"model":        "blackwell4000/qwen3.5:9b",
			"display_name": "Reasoning - Blackwell 4K Qwen 3.5 9B",
			"priority":     -52,
			"context_window_tokens": 32768,
			"max_output_tokens":     12288,
		},
		{
			"model":        "blackwell4000/mimo-v2.6:9b-q8_0",
			"display_name": "Code - Blackwell 4K MiMo V2.6 9B Q8",
			"priority":     -53,
