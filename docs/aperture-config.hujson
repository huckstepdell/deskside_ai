//
// Aperture (Tailscale) gateway config for the demo fleet.
// Paste into the Configuration page (/admin/config); saving validates it.
// HuJSON: comments and trailing commas are allowed.
//
{
	"auto_cost_basis": false,
	"providers": {
		"aperture": {
			"disabled": true,
		},
		"blackwell4000": {
			"baseurl": "http://pro-max-plus:8000",
			"models": [
				"nvidia/Qwen3-8B-NVFP4",
				"nvidia/Qwen3-8B-NVFP4-32k",
			],
			"authorization": "bearer",
			"compatibility": {
				"openai_chat": true,
			},
			"name":      "Blackwell 4000",
			"apikey":    "",
			"auth_mode": "none",
		},
		"rtx4070": {
			"baseurl": "http://aipc:8000",
			"models": [
				"Qwen/Qwen3-8B-AWQ",
			],
			"authorization": "bearer",
			"compatibility": {
				"openai_chat": true,
			},
			"name":      "RTX 4070",
			"apikey":    "",
			"auth_mode": "none",
		},
		"gb10": {
			"baseurl": "http://100.94.55.35:8000",
			"models": [
				"nvidia/Muse-Glimmer-30B-NVFP4",
			],
			"authorization": "bearer",
			"compatibility": {
				"openai_chat": true,
			},
			"apikey":    "",
			"auth_mode": "none",
			"name":      "GB10",
		},
		"gemini": {
			"baseurl": "https://generativelanguage.googleapis.com",
			"cost_basis": "google",
			"models": [
				"gemini-2.5-flash",
				"gemini-2.5-pro",
				"gemini-2.5-flash-lite",
				"gemini-3.1-pro-preview",
				"gemini-3.1-flash-lite",
				"gemini-3.5-flash",
				"gemini-3.5-flash-lite",
				"gemini-3.6-flash",
				"gemini-3.7-flash",
				"gemma-4-26b-a4b-it",
				"gemma-4-31b-it",
			],
			"authorization": "x-goog-api-key",
			"compatibility": {
				"gemini_generate_content": true,
			},
			"name":   "Google AI Studio",
			"apikey": "keyid:p:gemini:AQ.A..anGg",
		},
	},

	"chat_models": [
		// Default chat models. Higher priority sorts first in the picker.
		{
			"model":                 "gb10/nvidia/Muse-Glimmer-30B-NVFP4",
			"display_name":          "Chat - GB10 Muse Glimmer 30B (NVFP4)",
			"priority":              100,
			"title_gen":             true,
			"context_window_tokens": 65536,
			"max_output_tokens":     8192,
		},
		{
			"model":                 "blackwell4000/nvidia/Qwen3-8B-NVFP4",
			"display_name":          "Chat - Blackwell 4K Qwen 3 8B (NVFP4 · 64K)",
			"priority":              99,
			"context_window_tokens": 65536,
			"max_output_tokens":     8192,
		},
		{
			"model":                 "blackwell4000/nvidia/Qwen3-8B-NVFP4-32k",
			"display_name":          "Chat - Blackwell 4K Qwen 3 8B (NVFP4 · 32K Demo)",
			"priority":              97,
			"context_window_tokens": 32768,
			"max_output_tokens":     4096,
		},
		{
			"model":                 "rtx4070/Qwen/Qwen3-8B-AWQ",
			"display_name":          "Code - RTX 4070 Qwen 3 8B (AWQ)",
			"priority":              98,
			"context_window_tokens": 32768,
			"max_output_tokens":     4096,
		},
	],

	"grants": [
		{
			// Admins have full access to change all settings and view all data.
			// Replace "*" with specific users to restrict admin access.
			"src": [
				"*",
			],
			"app": {
				"tailscale.com/cap/aperture": [
					{"role": "admin"},
				],
			},
		},

		// Allow all users access to all models from all providers
		// (deny by default without this grant).
		{
			"src": ["*"],
			"app": {
				"tailscale.com/cap/aperture": [
					{"role": "user", "models": "**"},
					{"connectors": ["label:system"]},
				],
			},
		},
	],
}
