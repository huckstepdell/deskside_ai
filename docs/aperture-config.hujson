				"nemotron-3.5-bolt:e4b",
				"deepseek-coder-v2-lite",
			],
			"authorization": "bearer",
			"compatibility": {
				"openai_chat": true,
			},
			"name":      "Blackwell 4000",
			"apikey":    "",
			"auth_mode": "none",
		},
