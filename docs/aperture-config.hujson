//
// Aperture (Tailscale) gateway config for the demo fleet.
// Paste into the Configuration page (/admin/config); saving validates it.
// HuJSON: comments and trailing commas are allowed.
//
{
	"auto_cost_basis": false,
	"providers": {
		"aperture": {
			"disabled": true,
		},
		"blackwell4000": {
			"baseurl": "http://pro-max-plus:11435",
			"models": [
				"gemma4:12b",
				"qwen3.5:9b",
				"mimo-v2.6:9b",
				"mimo-v2.6:9b-q8_0",
				"nomic-embed-text",
			],
			"authorization": "bearer",
			"compatibility": {
				"openai_chat": true,
			},
			"name":      "Blackwell 4000",
			"apikey":    "",
			"auth_mode": "none",
		},
		"rtx4070": {
			"baseurl": "http://aipc:11435",
			"models": [
				"gemma4:12b",
				"gemma4:e4b",
				"qwen3.5:4b",
				"qwen3.5:2b",
				"lfm3:1.7b",
				"nomic-embed-text",
			],
			"authorization": "bearer",
			"compatibility": {
				"openai_chat": true,
			},
			"name":      "RTX 4070",
			"apikey":    "",
			"auth_mode": "none",
		},
		"gb10": {
			"baseurl": "http://100.94.55.35:11435",
			"models": [
				"nemotron-3.5-lightning:30b",
				"nemotron-3.5-bolt:latest",
				"gemma4:26b-a4b-it-qat",
				"gemma4:e4b",
				"nomic-embed-text",
			],
			"authorization": "bearer",
			"compatibility": {
				"openai_chat": true,
			},
			"apikey":    "",
			"auth_mode": "none",
			"name":      "GB10",
		},
	},

	"chat_models": [
		// Default chat models: Gemma 4 (vision). Higher priority sorts first in the picker.
		{
			"model":        "gb10/gemma4:26b-a4b-it-qat",
			"display_name": "Chat - GB10 Gemma 4 26B",
			"priority":     100,
			"context_window_tokens": 65536,
			"max_output_tokens":     8192,
		},
		{
			"model":        "blackwell4000/gemma4:12b",
			"display_name": "Chat - Blackwell 4K Gemma 4 12B",
