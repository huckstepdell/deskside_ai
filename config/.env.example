# API Keys and Tokens
# Copy this file to ~/.config/deskside_ai/.env and fill in your actual values

# OpenAI API Key
OPENAI_API_KEY=sk-...

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-...

# Hugging Face Token
HUGGINGFACE_TOKEN=hf_...

# Other API keys as needed
# COHERE_API_KEY=...
# MISTRAL_API_KEY=...
