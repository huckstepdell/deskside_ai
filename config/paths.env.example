# Path Configuration
# Copy this file to ~/.config/deskside_ai/paths.env and customize if needed
# These are the default paths - only override if you need custom locations

# Active runtime data directory
LAB_DIR=${HOME}/lab/deskside_ai

# Models directory
MODELS_DIR=${LAB_DIR}/models

# Datasets directory
DATASETS_DIR=${LAB_DIR}/datasets

# Working directory
WORK_DIR=${LAB_DIR}/work

# Notebooks directory
NOTEBOOKS_DIR=${LAB_DIR}/notebooks

# Docker volumes directory
VOLUMES_DIR=${LAB_DIR}/volumes

# Exports and results directory
EXPORTS_DIR=${LAB_DIR}/exports

# Cache directory
CACHE_DIR=${HOME}/.cache/deskside_ai

# Optional: Archive directory for old/backup data
# ARCHIVE_DIR=${HOME}/archives/deskside_ai
