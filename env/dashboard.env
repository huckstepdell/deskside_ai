# Dockhand stack env for the dashboard (compose.ui.yml)
# Replace the <...> placeholders with hostnames/IPs the dashboard container can reach.
OLLAMA_URL=http://aipc:11435
TELEMETRY_URL=http://aipc:9101
PRIMARY_LABEL=RTX 4070
DEMO_PROFILE=rtx4070
DEMO_HOSTS='{"blackwell":{"label":"Blackwell 4000","url":"http://pro-max-plus:11435","telemetry_url":"http://pro-max-plus:9101"}}'
# Optional: include Image Studio (SDXL, several GB of dependencies and weights)
# INSTALL_IMAGEGEN=1
# DOWNLOAD_IMAGEGEN=1 downloads SDXL weights into the persistent ./data cache at startup
# Image Studio also needs compose.ui.gpu.yml to pass the NVIDIA GPU to the UI container
# Optional: include NVIDIA DGX Spark playbooks in the dashboard image
# INSTALL_RUNBOOKS=1
