# Dockhand stack env for the dashboard (compose.ui.yml)
# Replace the <...> placeholders with hostnames/IPs the dashboard container can reach.
OLLAMA_URL=http://<blackwell-address>:11435
TELEMETRY_URL=http://<blackwell-address>:9101
PRIMARY_LABEL=Blackwell 4000
DEMO_PROFILE=blackwell4000
DEMO_HOSTS={"rtx4070":{"label":"RTX 4070","url":"http://<rtx4070-address>:11435","telemetry_url":"http://<rtx4070-address>:9101"}}
# Optional: include Image Studio (SDXL, ~4GB of wheels)
# INSTALL_IMAGEGEN=1
