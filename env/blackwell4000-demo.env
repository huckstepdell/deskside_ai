# Dockhand / --env-file for Blackwell 4000 like-for-like customer demo (32K context, matching RTX 4070)
#   docker compose -f compose.node.yml --env-file env/blackwell4000-demo.env up -d --build
DEMO_PROFILE=blackwell4000
DEVICE_NAME=Blackwell 4000
VLLM_MAX_MODEL_LEN=32768
VLLM_GPU_MEMORY_UTILIZATION=0.88
# Optional: HuggingFace token for gated models
# HF_TOKEN=
# Optional: pin published ports to this machine's tailnet/LAN IP
# BIND_IP=
