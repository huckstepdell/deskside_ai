# Dockhand / --env-file for Blackwell 4000 like-for-like customer demo (24K context, matching RTX 4070)
#   docker compose -f compose.node.yml --env-file env/blackwell4000-demo.env up -d --build
DEMO_PROFILE=blackwell4000
DEVICE_NAME=Blackwell 4000
VLLM_MAX_MODEL_LEN=24576
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_EXTRA_ARGS=--max-num-batched-tokens 2048 --served-model-name nvidia/Qwen3-8B-NVFP4-24k
# Optional: HuggingFace token for gated models
# HF_TOKEN=
# Optional: pin published ports to this machine's tailnet/LAN IP
# BIND_IP=
